---
import Logo from "../assets/icon.svg";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Garden City: Work, Rest & Tech Culture</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap");

      :root {
        --color-bg: #1a2023;
        --color-accent-1: #5d737e;
        --color-accent-2: #64b6ac;
        --color-highlight: #c0fdfb;
        --color-soft: #daffef;
        --color-text: #fcfffd;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: "Inter", sans-serif;
      }

      #pin-container {
        width: 100%;
        height: 100vh;
        position: relative;
        overflow: hidden;
      }

      /* Visuals - Always Full Screen Background */
      #visuals-container {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100vh;
        z-index: 0;
      }

      .slide-visual {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
      }

      .slide-visual:first-child {
        opacity: 1;
      }

      /* Full Page Backdrop Layer */
      #backdrop-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: var(--color-bg);
        opacity: 0.4;
        z-index: 1;
        pointer-events: none;
      }

      /* Slide Wrapper */
      .slide-content {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: auto;
        z-index: 5;
      }

      /* Header Wrapper (Title/Quote) */
      .header-wrapper {
        position: absolute;
        top: 50vh;
        left: 0;
        width: 100%; /* Ensure full width availability */
        padding: 2rem;
        z-index: 10;
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8);

        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        transform-origin: left top;
      }

      @media (min-width: 1024px) {
        .header-wrapper {
          padding: 4rem 6rem;
        }
      }

      /* Body Text Wrapper */
      .text-body {
        position: absolute;
        top: 100vh;
        left: 0;
        width: 100%;
        padding: 2rem;
        opacity: 0;

        display: flex;
        justify-content: flex-start;
      }

      .text-inner {
        max-width: 700px;
      }

      @media (min-width: 1024px) {
        .text-body {
          padding: 0 6rem;
        }
      }

      /* Typography */
      .section-name {
        color: var(--color-accent-2);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
        display: block;
      }

      h1,
      h2 {
        font-family: "Playfair Display", serif;
        color: var(--color-highlight);
        margin-bottom: 1rem;
        line-height: 1.1;
        text-align: left;
        width: 100%;
        transform-origin: left top;
      }

      h1 {
        font-size: 2.5rem;
      }
      h2 {
        font-size: 2rem;
      }

      blockquote {
        border-left: 4px solid var(--color-accent-2);
        padding-left: 1rem;
        margin: 0;
        font-style: italic;
        color: var(--color-soft);
        font-size: 1.2rem;
        font-family: "Playfair Display", serif;
        max-width: 600px;
        text-align: left;
        transform-origin: left top;
      }

      p {
        color: var(--color-text);
        line-height: 1.8;
        margin-bottom: 1.2rem;
        font-size: 1.1rem;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
      }

      ul {
        margin-left: 1.5rem;
        margin-bottom: 1.2rem;
        color: var(--color-soft);
      }

      li {
        margin-bottom: 0.5rem;
        line-height: 1.8;
        font-size: 1.1rem;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
      }

      .word {
        opacity: 0.2;
        color: var(--color-accent-1);
        display: inline;
      }

      @media (min-width: 1024px) {
        h1 {
          font-size: 5rem;
        }
        h2 {
          font-size: 4rem;
        }

        p {
          font-size: 1.5rem;
        }
      }

      /* Floating Menu Button */
      #floating-menu-btn {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: #fcfffd;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        z-index: 100;
        transition: transform 0.3s ease;
      }

      #floating-menu-btn:hover {
        transform: scale(1.1);
      }

      #floating-menu-btn.active {
        transform: rotate(45deg);
      }

      /* Menu Items Container */
      #floating-menu-items {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 99;
        width: 60px;
        height: 600px;
        pointer-events: none;

        display: flex;
        flex-direction: column-reverse;
        align-items: center;
      }

      #floating-menu-items:hover {
        pointer-events: auto;
      }

      #floating-menu-btn:hover ~ #floating-menu-items {
        pointer-events: auto;
      }

      .menu-item {
        position: fixed;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: #fcfffd;
        border: 2px solid var(--color-accent-2);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: var(--color-bg);
        font-weight: 600;
        font-family: "Playfair Display", serif;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        bottom: 2rem;
        transform-origin: center bottom;
      }
    </style>
  </head>
  <body>
    <div id="pin-container">
      <div id="visuals-container">
        <img
          src="https://picsum.photos/seed/garden1/1600/1200"
          class="slide-visual"
          alt="Intro"
        />
        <img
          src="https://picsum.photos/seed/work1/1600/1200"
          class="slide-visual"
          alt="Calling"
        />
        <img
          src="https://picsum.photos/seed/identity1/1600/1200"
          class="slide-visual"
          alt="Identity"
        />
        <img
          src="https://picsum.photos/seed/relax/1600/1200"
          class="slide-visual"
          alt="Rest"
        />
      </div>

      <div id="backdrop-layer"></div>

      <article id="content-container">
        <!-- Intro -->
        <section class="slide-content">
          <div class="header-wrapper">
            <span class="section-name">Introduction</span>
            <h1>Garden City: Work, Rest & Tech Culture</h1>
            <blockquote>"From creation to the final heavenly city"</blockquote>
          </div>
          <div class="text-body">
            <div class="text-inner">
              <p>This is a book by JMC</p>
            </div>
          </div>
        </section>

        <!-- Part I -->
        <section class="slide-content">
          <div class="header-wrapper">
            <span class="section-name">Part I</span>
            <h2>Work and your calling</h2>
            <blockquote>
              1 Corinthians 15 v 58: "Therefore, my dear brothers and sisters,
              stand firm. Let nothing move you. Always give yourselves fully to
              the work of the Lord, because you know that your labor in the Lord
              is not in vain."
            </blockquote>
          </div>
          <div class="text-body">
            <div class="text-inner">
              <p>
                We think of work as a means to an end. But God intends for the
                work to be worship, and to be the means in and of itsself.
              </p>
              <p>
                You spend the majority of your life at work. it's "what you do".
                What are you giving your life to?
              </p>
              <p>
                The first job was caring for the garden. And it wasn't a tame
                garden in the beginning. it was made to be tamed.
              </p>
              <h3>Questions</h3>
              <ul>
                <li>
                  Do you think you have a calling? Are you working towards it
                  now?
                </li>
                <li>
                  What about your work do you enjoy? In what ways are you using
                  your personality in your work?
                </li>
                <li>How could you orient your work to be worship to God?</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Part II -->
        <section class="slide-content">
          <div class="header-wrapper">
            <span class="section-name">Part II</span>
            <h2>Rest and the Sabbath</h2>
            <blockquote>
              Exodus 20 v 8-11: "Remember the Sabbath day by keeping it holy.
              Six days you shall labor and do all your work, but the seventh day
              is a sabbath to the Lord your God. On it you shall not do any
              work, neither you, nor your son or daughter, nor your male or
              female servant, nor your animals, nor any foreigner residing in
              your towns. For in six days the Lord made the heavens and the
              earth, the sea, and all that is in them, but he rested on the
              seventh day. Therefore the Lord blessed the Sabbath day and made
              it holy."
            </blockquote>
          </div>
          <div class="text-body">
            <div class="text-inner">
              <p>Sabbath is for two things:</p>
              <ul>
                <li>returning to the garden</li>
                <li>escaping the Pharoh</li>
              </ul>
              <p>We have an addiction to work and productivity.</p>
              <h3>Questions</h3>
              <ul>
                <li>
                  Have you ever taken a Sabbath? What would a perfect rest day
                  look like for you?
                </li>
                <li>
                  How do we feel about the idea of <em>stopping</em> working to rest?
                </li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Part III -->
        <section class="slide-content">
          <div class="header-wrapper">
            <span class="section-name">Part III</span>
            <h2>The Garden City</h2>
            <blockquote>
              Isaiah 65 v 17-18, 21-23: "See, I will create new heavens and a
              new earth. The former things will not be remembered, nor will they
              come to mind. But be glad and rejoice forever in what I will
              create, for I will create Jerusalem to be a delight and its people
              a joy. They will build houses and dwell in them; they will plant
              vineyards and eat their fruit. No longer will they build houses
              and others live in them, or plant and others eat. For as the days
              of a tree, so will be the days of my people; my chosen ones will
              long enjoy the work of their hands. They will not labor in vain,
              nor will they bear children doomed to misfortune."
            </blockquote>
          </div>
          <div class="text-body">
            <div class="text-inner">
              <p>
                Gods mission is not to evacuate us from this world. God's plan
                is a <em>new earth</em>.
              </p>
              <p>
                The closing image in revelation is a city. We were always
                supposed to work the garden! Everything around us was designed
                and built. Notice this and rejoice!
              </p>
              <p>
                Sometimes our work feels insignificant if we are not preaching
                or evangelising. But we are all needed in the garden!
              </p>
              <h3>Questions</h3>
              <ul>
                <li>
                  How do you feel about this idea that we would be "working for
                  God" in the new earth?
                </li>
                <li>
                  What would change if you believed God wanted to work through
                  your vocation right now?
                </li>
              </ul>
            </div>
          </div>
        </section>
      </article>
    </div>

    <!-- Floating Navigation Menu -->
    <div id="floating-menu-items">
      <button class="menu-item" data-slide-index="4" title="Resiliance">
        III
      </button>
      <button class="menu-item" data-slide-index="3" title="Rest"> II </button>
      <button class="menu-item" data-slide-index="2" title="Identity">
        I
      </button>
      <button class="menu-item" data-slide-index="1" title="Calling">
        <Logo fill="black" width="20px" />
      </button>
    </div>
  </body>
  <button id="floating-menu-btn" class="">+</button>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function wrapWords(el: Element): void {
      const textNodes: Node[] = [];
      function walk(node: Node): void {
        if (node.nodeType === 3) textNodes.push(node);
        else node.childNodes.forEach(walk);
      }
      walk(el);

      textNodes.forEach((node: Node) => {
        const text = node.nodeValue;
        if (!text || !text.trim()) return;
        const words = text.split(/(\s+)/);
        const frag = document.createDocumentFragment();
        words.forEach((word: string) => {
          if (word.match(/^\s+$/))
            frag.appendChild(document.createTextNode(word));
          else if (word.trim()) {
            const span = document.createElement("span");
            span.className = "word";
            span.textContent = word;
            frag.appendChild(span);
          }
        });
        if (node.parentNode) node.parentNode.replaceChild(frag, node);
      });
    }

    const slides: NodeListOf<Element> =
      document.querySelectorAll(".slide-content");
    const visuals: NodeListOf<Element> =
      document.querySelectorAll(".slide-visual");
    const pinContainer: Element | null =
      document.querySelector("#pin-container");
    const backdrop: Element | null = document.querySelector("#backdrop-layer");

    const isMobile = window.innerWidth < 1024;
    const collapsedPadding = isMobile ? "1rem" : "2rem";

    slides.forEach((slide: Element, i: number) => {
      const paragraphs: NodeListOf<Element> =
        slide.querySelectorAll(".text-body p");
      paragraphs.forEach((p: Element) => wrapWords(p));

      const header: Element | null = slide.querySelector(".header-wrapper");
      const body: Element | null = slide.querySelector(".text-body");

      if (i === 0) {
        gsap.set(header, { top: "50vh", opacity: 1 });
        gsap.set(body, { top: "100vh", opacity: 0 });
        gsap.set(slide, { zIndex: 10, opacity: 1 });
        gsap.set(visuals[i], { opacity: 1 });
      } else {
        gsap.set(slide, { zIndex: 1, opacity: 0 });
        gsap.set(header, { top: "30vh", opacity: 1 });
        gsap.set(body, { top: "100vh", opacity: 0 });
        gsap.set(visuals[i], { opacity: 0 });
      }
    });

    gsap.set(backdrop, { opacity: 0.4 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: pinContainer,
        pin: true,
        start: "top top",
        // Longer scroll duration to separate phases
        end: () => "+=800%",
        scrub: 1,
      },
    });

    slides.forEach((slide: Element, i: number) => {
      const header: Element | null = slide.querySelector(".header-wrapper");
      const body: Element | null = slide.querySelector(".text-body");
      const words: NodeListOf<Element> = slide.querySelectorAll(".word");
      const visual: Element = visuals[i];

      const title: Element | null = header?.querySelector("h1, h2") || null;
      const quote: Element | null = header?.querySelector("blockquote") || null;

      const nextSlide: Element | undefined = slides[i + 1];
      const nextVisual: Element | undefined = visuals[i + 1];

      // --- PHASE 1: ENTER READING MODE ---
      const p1 = gsap.timeline();

      const body_delay = 10;

      p1.to(
        backdrop,
        { opacity: 0.9, duration: 4, ease: "power1.inOut" },
        body_delay,
      );

      // Header moves to top (0) - SLOWER DURATION (4s)
      p1.to(
        header,
        {
          top: "0",
          paddingTop: collapsedPadding,
          duration: 4,
          ease: "power2.inOut",
        },
        body_delay,
      );

      p1.to(
        title,
        {
          width: "167%",
          scale: 0.6,
          transformOrigin: "left top",
          duration: 4,
          ease: "power2.inOut",
        },
        body_delay,
      );

      // Quote fades out
      p1.to(
        quote,
        { autoAlpha: 0, height: 0, margin: 0, duration: 4 },
        body_delay,
      );

      // Body Moves to Reading Position
      // Adjusted to start near top instead of center to handle long text better
      p1.to(
        body,
        {
          top: "15vh",
          yPercent: 0,
          opacity: 1,
          duration: 4,
          ease: "power2.out",
        },
        body_delay + 0.5,
      );

      tl.add(p1);

      // --- PHASE 2: READ BODY ---
      const p2 = gsap.timeline();

      const wordStagger = 0.1;
      const wordFadeDuration = 5;
      // Calculate total duration based on word count to ensure sync
      const totalReadingDuration =
        words.length * wordStagger + wordFadeDuration;

      if (words.length > 0) {
        p2.to(
          words,
          {
            opacity: 1,
            color: "var(--color-text)",
            stagger: wordStagger,
            duration: wordFadeDuration,
            ease: "none",
          },
          0,
        );
      }

      // Calculate dynamic scroll distance
      const contentHeight = body instanceof HTMLElement ? body.offsetHeight : 0;
      const viewportHeight = window.innerHeight;
      // Approximate available space (screen - top margin - bottom buffer)
      const availableSpace = viewportHeight * 0.7;

      let scrollY = 0;
      if (contentHeight > availableSpace) {
        // Scroll up enough to show the bottom, plus a bit
        scrollY = contentHeight - availableSpace + 100;
      }

      p2.to(
        body,
        {
          y: -scrollY,
          duration: totalReadingDuration, // Sync scroll with reading
          ease: "none",
        },
        0,
      );

      tl.add(p2);

      // --- PHASE 3: TRANSITION TO NEXT ---
      if (nextSlide) {
        const p3 = gsap.timeline();

        const slide_transition_duration = 6;

        p3.to(
          backdrop,
          { opacity: 0.4, duration: slide_transition_duration },
          0,
        );
        p3.to(slide, { opacity: 0, duration: slide_transition_duration }, 0);
        p3.to(visual, { opacity: 0, duration: slide_transition_duration }, 0);

        p3.set(
          nextSlide,
          { zIndex: 10, opacity: 1 },
          slide_transition_duration / 2,
        );

        p3.to(
          nextVisual,
          { opacity: 1, duration: slide_transition_duration },
          0,
        );

        tl.add(p3);
      }
    });

    ScrollTrigger.refresh();

    // Floating Menu Functionality
    const floatingMenuBtn: Element | null =
      document.getElementById("floating-menu-btn");
    const floatingMenuItems: Element | null = document.getElementById(
      "floating-menu-items",
    );
    const menuItems: NodeListOf<Element> =
      document.querySelectorAll(".menu-item");

    if (!floatingMenuItems || !floatingMenuBtn)
      throw new Error("elements don't exist");

    // Initialize menu items to hidden state
    gsap.set(menuItems, {
      opacity: 0,
      pointerEvents: "none",
      scale: 0,
      y: 0,
    });

    // Setup click handlers for menu items
    menuItems.forEach((item: Element) => {
      const slideIndex = parseInt(item.getAttribute("data-slide-index") || "0");
      item.addEventListener("click", (e) => {
        e.stopPropagation();
        scrollToSlide(slideIndex);
        closeMenu();
      });
    });

    // Toggle menu on button click (touch support)
    floatingMenuBtn.addEventListener("click", (e) => {
      console.log("floatingMenuBtn clicked");
      e.stopPropagation();
      floatingMenuBtn.classList.contains("active") ? closeMenu() : openMenu();
    });

    // Hover to open menu (desktop)
    floatingMenuBtn.addEventListener("mouseenter", openMenu);
    floatingMenuBtn.addEventListener("mouseenter", () => {
      console.log("floatingMenuBtn mouse enter");
    });

    floatingMenuBtn.addEventListener("mouseleave", () => {
      setTimeout(() => {
        if (!floatingMenuItems.matches(":hover")) {
          closeMenu();
        }
      }, 150);
    });

    floatingMenuItems.addEventListener("mouseleave", closeMenu);
    floatingMenuItems.addEventListener("mouseleave", () =>
      console.log("floatingMenuItems mouse leave"),
    );

    function openMenu() {
      if (!floatingMenuBtn) return;
      if (floatingMenuBtn.classList.contains("active")) return;

      console.log("adding active class...");
      floatingMenuBtn.classList.add("active");

      // Animate menu items opening vertically above button
      menuItems.forEach((item: Element, index: number) => {
        // Position items vertically above button (top to bottom)
        const yOffset = -(index + 1) * 70 - 15; // 70px spacing between items

        gsap.to(item, {
          opacity: 1,
          pointerEvents: "auto",
          scale: 1,
          y: yOffset,
          duration: 0.4,
          delay: index * 0.08,
          ease: "back.out",
        });
      });
    }

    function closeMenu() {
      if (!floatingMenuBtn) return;
      if (!floatingMenuBtn.classList.contains("active")) return;

      console.log("removing active class...");
      floatingMenuBtn.classList.remove("active");

      // Animate menu items closing
      gsap.to(menuItems, {
        opacity: 0,
        pointerEvents: "none",
        scale: 0,
        y: 0,
        duration: 0.3,
        ease: "back.in",
      });
    }

    function scrollToSlide(slideIndex: number) {
      // The timeline total duration represents all 7 slides
      // Each slide gets approximately equal scroll distance
      const slideHeight = window.innerHeight;
      // Calculate based on the 800% end value in scrollTrigger
      const totalScrollDistance = slideHeight * 8;
      // Distribute evenly across 7 slides
      const scrollAmount = (slideIndex / 7) * totalScrollDistance;
      window.scrollTo({ top: scrollAmount, behavior: "smooth" });
    }

    // Close menu when clicking elsewhere
    document.addEventListener("click", () => {
      if (floatingMenuBtn.classList.contains("active")) closeMenu();
    });
  </script>
</html>
