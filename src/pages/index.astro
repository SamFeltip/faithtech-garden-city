    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      function wrapWords(el: Element): void {
        const textNodes: Node[] = [];
        function walk(node: Node): void {
          if (node.nodeType === 3) textNodes.push(node);
          else node.childNodes.forEach(walk);
        }
        walk(el);

        textNodes.forEach((node: Node) => {
          const text = node.nodeValue;
          if (!text || !text.trim()) return;
          const words = text.split(/(\s+)/);
          const frag = document.createDocumentFragment();
          words.forEach((word: string) => {
            if (word.match(/^\s+$/))
              frag.appendChild(document.createTextNode(word));
            else if (word.trim()) {
              const span = document.createElement("span");
              span.className = "word";
              span.textContent = word;
              frag.appendChild(span);
            }
          });
          if (node.parentNode) node.parentNode.replaceChild(frag, node);
        });
      }

      const slides: NodeListOf<Element> =
        document.querySelectorAll(".slide-content");
      const visuals: NodeListOf<Element> =
        document.querySelectorAll(".slide-visual");
      const pinContainer: Element | null =
        document.querySelector("#pin-container");
      const backdrop: Element | null =
        document.querySelector("#backdrop-layer");

      const isMobile = window.innerWidth < 1024;
      const collapsedPadding = isMobile ? "1rem" : "2rem";

      slides.forEach((slide: Element, i: number) => {
        const paragraphs: NodeListOf<Element> =
          slide.querySelectorAll(".text-body p");
        paragraphs.forEach((p: Element) => wrapWords(p));

        const header: Element | null = slide.querySelector(".header-wrapper");
        const body: Element | null = slide.querySelector(".text-body");

        if (i === 0) {
          gsap.set(header, { top: "50vh", opacity: 1 });
          gsap.set(body, { top: "100vh", opacity: 0 });
          gsap.set(slide, { zIndex: 10, opacity: 1 });
          gsap.set(visuals[i], { opacity: 1 });
        } else {
          gsap.set(slide, { zIndex: 1, opacity: 0 });
          gsap.set(header, { top: "50vh", opacity: 1 });
          gsap.set(body, { top: "100vh", opacity: 0 });
          gsap.set(visuals[i], { opacity: 0 });
        }
      });

      gsap.set(backdrop, { opacity: 0.4 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pinContainer,
          pin: true,
          start: "top top",
          // Longer scroll duration to separate phases
          end: () => "+=800%",
          scrub: 1,
        },
      });

      slides.forEach((slide: Element, i: number) => {
        const header: Element | null = slide.querySelector(".header-wrapper");
        const body: Element | null = slide.querySelector(".text-body");
        const words: NodeListOf<Element> = slide.querySelectorAll(".word");
        const visual: Element = visuals[i];

        const title: Element | null = header?.querySelector("h1, h2") || null;
        const quote: Element | null =
          header?.querySelector("blockquote") || null;

        const nextSlide: Element | undefined = slides[i + 1];
        const nextVisual: Element | undefined = visuals[i + 1];

        // --- PHASE 1: ENTER READING MODE ---
        const p1 = gsap.timeline();

        const body_delay = 10;

        p1.to(
          backdrop,
          { opacity: 0.9, duration: 4, ease: "power1.inOut" },
          body_delay,
        );

        // Header moves to top (0) - SLOWER DURATION (4s)
        p1.to(
          header,
          {
            top: "0",
            paddingTop: collapsedPadding,
            duration: 4,
            ease: "power2.inOut",
          },
          body_delay,
        );

        p1.to(
          title,
          {
            width: "167%",
            scale: 0.6,
            transformOrigin: "left top",
            duration: 4,
            ease: "power2.inOut",
          },
          body_delay,
        );

        // Quote fades out
        p1.to(
          quote,
          { autoAlpha: 0, height: 0, margin: 0, duration: 4 },
          body_delay,
        );

        // Body Moves to Center
        p1.to(
          body,
          {
            top: "55%",
            yPercent: -50,
            opacity: 1,
            duration: 4,
            ease: "power2.out",
          },
          body_delay + 0.5,
        );

        tl.add(p1);

        // --- PHASE 2: READ BODY ---
        const p2 = gsap.timeline();

        if (words.length > 0) {
          p2.to(
            words,
            {
              opacity: 1,
              color: "var(--color-text)",
              stagger: 0.1,
              duration: 5,
              ease: "none",
            },
            0,
          );
        }

        p2.to(
          body,
          {
            yPercent: -60,
            duration: 5,
            ease: "none",
          },
          0,
        );

        tl.add(p2);

        // --- PHASE 3: TRANSITION TO NEXT ---
        if (nextSlide) {
          const p3 = gsap.timeline();

          const slide_transition_duration = 6;

          p3.to(
            backdrop,
            { opacity: 0.4, duration: slide_transition_duration },
            0,
          );
          p3.to(slide, { opacity: 0, duration: slide_transition_duration }, 0);
          p3.to(visual, { opacity: 0, duration: slide_transition_duration }, 0);

          p3.set(
            nextSlide,
            { zIndex: 10, opacity: 1 },
            slide_transition_duration / 2,
          );

          p3.to(
            nextVisual,
            { opacity: 1, duration: slide_transition_duration },
            0,
          );

          tl.add(p3);
        }
      });

      ScrollTrigger.refresh();
    </script>
  </body>
