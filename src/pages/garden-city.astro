---
import { getCollection } from "astro:content";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Garden City: Work, Rest & Tech Culture</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap");

      :root {
        --color-bg: #1a2023;
        --color-accent-1: #5d737e;
        --color-accent-2: #64b6ac;
        --color-highlight: #c0fdfb;
        --color-soft: #daffef;
        --color-text: #fcfffd;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: "Inter", sans-serif;
      }

      /* Main container that will be pinned */
      #pin-container {
        width: 100%;
        height: 100vh;
        position: relative;
        overflow: hidden;
      }

      /* Fixed Visuals Container */
      #visuals-container {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 30vh; /* REDUCED MOBILE HEIGHT */
        z-index: 1;
      }

      @media (min-width: 1024px) {
        #visuals-container {
          width: 50%; /* Desktop split */
          height: 100vh;
        }
      }

      .slide-visual {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0; /* Default hidden */
      }

      .slide-visual:first-child {
        opacity: 1; /* First one visible */
      }

      .visual-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* Darker backdrop on mobile for better text contrast if overlap occurs */
        background: linear-gradient(to bottom, rgba(26,32,35,0.2), var(--color-bg));
        opacity: 0.8; /* Increased opacity */
        z-index: 2;
      }

      /* Content Container */
      #content-container {
        position: absolute;
        top: 30vh; /* Matches visual height */
        left: 0;
        width: 100%;
        height: 70vh; /* Remaining space */
        z-index: 2;
        /* Ensure background is solid to prevent visual bleed */
        background-color: var(--color-bg); 
      }

      @media (min-width: 1024px) {
        #content-container {
          top: 0;
          width: 50%;
          height: 100vh;
          background-color: transparent; /* Transparent on desktop */
        }
      }

      /* Individual Slide */
      .slide-content {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        padding: 1.5rem; /* Reduced padding for mobile */
        display: flex;
        flex-direction: column;
        justify-content: flex-start; /* Start from top to avoid centering overlapping top edge */
        padding-top: 2rem;
        opacity: 0; /* Default hidden */
        
        /* Enable scrolling within the slide if text is long */
        overflow-y: auto; 
        pointer-events: auto;
        
        /* Smooth scrolling and chaining */
        -webkit-overflow-scrolling: touch; 
        overscroll-behavior: auto; /* Ensure scroll chain to window works */
      }

      .slide-content:first-child {
        opacity: 1;
      }

      @media (min-width: 1024px) {
        .slide-content {
          padding: 6rem;
          /* FIX: Use flex-start and fixed top padding for constant positioning */
          justify-content: flex-start; 
          padding-top: 20vh;
          
          /* Desktop usually fits, but auto is safer */
          overflow-y: visible; 
        }
      }

      /* Typography */
      .section-name {
        color: var(--color-accent-2);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-size: 0.8rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
        display: block;
      }

      h1, h2 {
        font-family: "Playfair Display", serif;
        color: var(--color-highlight);
        margin-bottom: 1rem;
        line-height: 1.1;
      }

      h1 { font-size: 2rem; }
      h2 { font-size: 1.75rem; }

      @media (min-width: 1024px) {
        h1 { font-size: 3rem; margin-bottom: 1.5rem; }
        h2 { font-size: 2.5rem; margin-bottom: 1.5rem; }
      }

      blockquote {
        border-left: 4px solid var(--color-accent-1);
        padding-left: 1rem;
        margin: 1rem 0;
        font-style: italic;
        color: var(--color-soft);
        font-size: 1rem;
        font-family: "Playfair Display", serif;
      }

      @media (min-width: 1024px) {
        blockquote {
            padding-left: 1.5rem;
            margin: 1.5rem 0;
            font-size: 1.1rem;
        }
      }

      .text-body {
        margin-top: 0.5rem;
        padding-bottom: 5rem; /* Extra space at bottom for scroll chaining */
      }

      p {
        line-height: 1.6;
        margin-bottom: 1rem;
        color: var(--color-text);
        font-size: 1rem;
      }

      @media (min-width: 1024px) {
        p {
          line-height: 1.8;
          font-size: 1.1rem;
          margin-bottom: 1.5rem;
        }
      }

      ul {
        margin-left: 1.5rem;
        margin-bottom: 1rem;
        color: var(--color-soft);
      }
      
      li {
        margin-bottom: 0.5rem;
      }

      /* Word Animation */
      .word {
        opacity: 0.2;
        color: var(--color-accent-1);
        display: inline; 
        transition: color 0.1s, opacity 0.1s;
      }
    </style>
  </head>
  <body>

    <!-- Main Pinned Container -->
    <div id="pin-container">
      
      <!-- Visuals (Right side on Desktop) -->
      <div id="visuals-container">
        <div class="visual-overlay"></div>
        <!-- Images correspond to slides -->
        <img src="https://picsum.photos/seed/garden1/800/1000" class="slide-visual" alt="Intro" />
        <img src="https://picsum.photos/seed/work1/800/1000" class="slide-visual" alt="Calling" />
        <img src="https://picsum.photos/seed/identity1/800/1000" class="slide-visual" alt="Identity" />
        <img src="https://picsum.photos/seed/relax/800/1000" class="slide-visual" alt="Rest" />
        <img src="https://picsum.photos/seed/city/800/1000" class="slide-visual" alt="Kingdom" />
        <img src="https://picsum.photos/seed/office/800/1000" class="slide-visual" alt="Faith" />
        <img src="https://picsum.photos/seed/code/800/1000" class="slide-visual" alt="Applying" />
      </div>

      <!-- Content (Left side on Desktop) -->
      <div id="content-container">
        
        <!-- Intro Slide -->
        <div class="slide-content">
          <span class="section-name">Introduction</span>
          <h1>Garden City: Work, Rest & Tech Culture</h1>
          <blockquote>"From creation to the final heavenly city"</blockquote>
          <div class="text-body">
            <p>John Mark Comer's <em>Garden City</em> reframes our 9-to-5 as part of God's grand story. It helps us find our place in the divine plan, moving from the first garden to the final city.</p>
            <p>In Genesis, humanity is made to "work it and take care of it" as an act of service. Even coding or system administration can be sacred—our tech work becomes <em>worship</em> when we use it to care for God's world.</p>
            <p>The future isn't just a return to Eden, but a journey forward into a "Garden-like world" where we cooperate with God in building a civilization for human flourishing.</p>
          </div>
        </div>

        <!-- Slide 1 -->
        <div class="slide-content">
          <span class="section-name">Part I</span>
          <h2>Your Calling: Work as God's Mission</h2>
          <blockquote>"Whatever you do, work heartily, as for the Lord"</blockquote>
          <div class="text-body">
            <p>Comer emphasizes that <strong>every</strong> job matters. "All work is holy" by God's design. We were not made to pull church and career apart.</p>
            <p>As a believer in tech, you have a <strong>dual vocation</strong>:</p>
            <ul>
              <li><strong>Professional:</strong> Make your company's systems sing, as if recreating Eden.</li>
              <li><strong>Disciple:</strong> Let your character raise questions about meaning, hope, and joy.</li>
            </ul>
            <p>There is no sacred-secular divide. Whether engineering software or managing data, you are stewarding Creation. Ask yourself: <em>Does my project make the world more 'garden-like'?</em></p>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="slide-content">
          <span class="section-name">Part II</span>
          <h2>Identity: Image Bearers, Not Just Doers</h2>
          <blockquote>"In God's image," not your job</blockquote>
          <div class="text-body">
            <p>Tech culture often defines us by titles or output ("I'm a developer at X"). <em>Garden City</em> pushes back: your primary identity is in God, not your career.</p>
            <p>Scripture says who we are (God's beloved) gives meaning to what we do, not the reverse. This frees us from performance-driven anxiety.</p>
            <p>Like J.S. Bach signing music <em>Soli Deo Gloria</em> ("to the glory of God"), our code can carry the same motto. Let <strong>who you are in Christ</strong> guide how you work, countering the idol of busyness.</p>
          </div>
        </div>

        <!-- Slide 3 -->
        <div class="slide-content">
          <span class="section-name">Part III</span>
          <h2>Rest & Resilience: Rediscovering Sabbath</h2>
          <blockquote>"We are not machines"</blockquote>
          <div class="text-body">
            <p>The tech world glorifies hustle. But God worked six days and "on the seventh day he rested." <em>Garden City</em> stresses that burnout is real. Rest isn't just a nap; it's a deliberate pause.</p>
            <p>Tiffany Shlain coins the <strong>"Tech Sabbath"</strong>—one day a week without screens. It's an oasis of peace.</p>
            <p>By resting, we acknowledge "God is God and we are not." We trust Him rather than our own productivity.</p>
          </div>
        </div>

        <!-- Slide 4 -->
        <div class="slide-content">
          <span class="section-name">Part IV</span>
          <h2>Living in the Kingdom</h2>
          <blockquote>"Building a Kingdom on earth"</blockquote>
          <div class="text-body">
            <p>Every office is a <strong>missional</strong> context. Companies often have unspoken agendas (profit, consumerism). We enter with a Kingdom worldview.</p>
            <p>Comer invites us to think big: we are helping build a civilization where God's will is done "on earth as it is in heaven."</p>
            <p>Every ethical decision, helpful tool, or faithful action pushes back darkness and spreads the beauty of God's Kingdom.</p>
          </div>
        </div>

        <!-- Slide 5 -->
        <div class="slide-content">
          <span class="section-name">Part V</span>
          <h2>Faith at Work</h2>
          <blockquote>"Live your faith softly"</blockquote>
          <div class="text-body">
            <p>In secular tech firms, overt evangelism is often unwelcome. Instead, focus on excellence and kindness. Let your work ethic and integrity do the talking.</p>
            <p>Like Daniel, who served faithfully in a pagan culture without compromising his core beliefs, we can refuse unethical practices while excelling at our assignments.</p>
            <p>Whether your workplace is "Faith-Avoiding" or "Faith-Tolerant," serve the Lord Christ through your competence and character.</p>
          </div>
        </div>

        <!-- Slide 6 -->
        <div class="slide-content">
          <span class="section-name">Part VI</span>
          <h2>Applying Garden City</h2>
          <blockquote>"Your tech job is God's job"</blockquote>
          <div class="text-body">
            <p><strong>Concrete steps for techies:</strong></p>
            <ul>
              <li><strong>Work Heartily:</strong> Write clean code to honor God.</li>
              <li><strong>Envision Impact:</strong> Does this help humans flourish?</li>
              <li><strong>Rest Intentionally:</strong> Try a screen-free Sabbath.</li>
              <li><strong>Live Out Faith:</strong> Be the person others point to as an example of what is best.</li>
              <li><strong>Keep Eternity in View:</strong> We are building Heaven's city, one task at a time.</li>
            </ul>
            <p><em>Garden City</em> allows us to see our work with new eyes. We are co-creators in God's world.</p>
          </div>
        </div>

      </div>
    </div>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // --- Helper: Recursive Text Splitting ---
      function wrapWords(el) {
        // Collect text nodes
        const textNodes = [];
        function walk(node) {
            if (node.nodeType === 3) { // Text
                textNodes.push(node);
            } else {
                node.childNodes.forEach(walk);
            }
        }
        walk(el);

        textNodes.forEach(node => {
            const text = node.nodeValue;
            if (!text.trim()) return;
            
            const words = text.split(/(\s+)/); // Split keeping delimiters
            const frag = document.createDocumentFragment();
            
            words.forEach(word => {
                if (word.match(/^\s+$/)) {
                    frag.appendChild(document.createTextNode(word));
                } else if (word.trim()) {
                    const span = document.createElement("span");
                    span.className = "word";
                    span.textContent = word;
                    frag.appendChild(span);
                }
            });
            
            node.parentNode.replaceChild(frag, node);
        });
      }

      // --- Init ---
      const slides = document.querySelectorAll(".slide-content");
      const visuals = document.querySelectorAll(".slide-visual");
      const pinContainer = document.querySelector("#pin-container");

      // 1. Prepare Text & Initial States
      slides.forEach((slide, i) => {
        const paragraphs = slide.querySelectorAll(".text-body p");
        paragraphs.forEach(wrapWords);
        
        // Explicitly set initial states to avoid FOUC or logical gaps
        if (i !== 0) {
            gsap.set(slide, { opacity: 0 });
            gsap.set(slide.querySelectorAll(".text-body"), { x: 50, opacity: 0 });
            gsap.set(slide.querySelectorAll("h1, h2, blockquote, .section-name"), { y: 20, opacity: 0 });
        }
        
        // Visuals
        if (i !== 0) {
             gsap.set(visuals[i], { opacity: 0 });
        } else {
             gsap.set(visuals[i], { opacity: 1 });
        }
      });

      // 2. Master Timeline
      // We will pin the container and scrub through all slides
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pinContainer,
          pin: true,
          start: "top top",
          // INCREASED SCROLL LENGTH for smoother, slower experience
          end: () => "+=" + (slides.length * 400) + "%", 
          scrub: 1, // Increased smooth scrubbing
          // markers: true
        }
      });

      slides.forEach((slide, i) => {
        const words = slide.querySelectorAll(".word");
        const titleElements = slide.querySelectorAll("h1, h2, blockquote, .section-name");
        const textBody = slide.querySelector(".text-body");
        const nextSlide = slides[i + 1];
        const nextVisual = visuals[i + 1];
        
        // A. Read Phase: Highlight Words
        if (words.length > 0) {
          tl.to(words, {
            opacity: 1,
            color: "var(--color-text)",
            stagger: 0.1, // Slower stagger
            duration: 5, // Longer reading duration
            ease: "none"
          });
        } else {
            // Fallback duration if no words
            tl.to({}, { duration: 2 });
        }

        // B. Transition Phase (if there is a next slide)
        if (nextSlide) {
          
          // Parallel animations for transition
          const transitionTl = gsap.timeline();

          // 1. Current Text moves Left and Fades
          transitionTl.to(textBody, {
            x: -50,
            opacity: 0,
            duration: 2,
            ease: "power2.inOut"
          }, 0);

          // 2. Current Title Fades Out
          transitionTl.to(titleElements, {
            opacity: 0,
            y: -20,
            duration: 2,
            ease: "power2.inOut"
          }, 0);

          // 3. Visuals Crossfade
          transitionTl.to(nextVisual, {
            opacity: 1,
            duration: 3, // Slower crossfade
            ease: "none"
          }, 0);
          
          transitionTl.to(visuals[i], {
            opacity: 0,
            duration: 3
          }, 0);

          // 4. Next Slide In
          const nextTitleElements = nextSlide.querySelectorAll("h1, h2, blockquote, .section-name");
          const nextTextBody = nextSlide.querySelector(".text-body");
          
          // Reveal the next container
          transitionTl.to(nextSlide, {
            opacity: 1,
            duration: 0.1 
          }, 1); // Start overlap
          
          // Animate elements in
          transitionTl.fromTo(nextTitleElements, 
            { opacity: 0, y: 20 },
            { opacity: 1, y: 0, duration: 2, stagger: 0.2 },
            1.5
          );
          
          transitionTl.fromTo(nextTextBody,
            { x: 50, opacity: 0 }, 
            { x: 0, opacity: 1, duration: 2 },
            1.5
          );

          // Add transition to master
          tl.add(transitionTl);
        }
      });
      
    </script>
  </body>
</html>
