---
import { getCollection } from "astro:content";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Garden City: Work, Rest & Tech Culture</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap");

      :root {
        --color-bg: #1a2023;
        --color-accent-1: #5d737e;
        --color-accent-2: #64b6ac;
        --color-highlight: #c0fdfb;
        --color-soft: #daffef;
        --color-text: #fcfffd;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: "Inter", sans-serif;
        overflow-x: hidden;
      }

      .scrolly-container {
        width: 100%;
        position: relative;
      }

      section {
        height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 0;
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        /* Ensure sections stack cleanly */
        z-index: 1; 
      }

      /* Desktop Layout: Side by Side */
      @media (min-width: 1024px) {
        section {
          flex-direction: row;
        }

        section:nth-child(even) {
          flex-direction: row-reverse;
        }
      }

      .content-wrapper {
        flex: 1;
        padding: 2rem;
        z-index: 2;
        max-width: 800px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        /* Position relative for elements inside */
        position: relative;
      }

      @media (min-width: 1024px) {
        .content-wrapper {
          padding: 6rem;
        }
      }

      .visual-wrapper {
        flex: 1;
        width: 100%;
        height: 100%; /* Full height for the image container */
        position: relative;
        overflow: hidden;
      }

      .visual-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.8;
      }

      .section-name {
        color: var(--color-accent-2);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        font-weight: 600;
        display: block;
      }

      h1,
      h2 {
        font-family: "Playfair Display", serif;
        color: var(--color-highlight);
        margin-bottom: 1.5rem;
        line-height: 1.1;
      }

      h1 {
        font-size: 3rem;
      }
      h2 {
        font-size: 2.5rem;
      }

      blockquote {
        border-left: 4px solid var(--color-accent-1);
        padding-left: 1.5rem;
        margin: 2rem 0;
        font-style: italic;
        color: var(--color-soft);
        font-size: 1.25rem;
        font-family: "Playfair Display", serif;
      }

      p {
        line-height: 1.8;
        margin-bottom: 1.5rem;
        color: var(--color-text);
        font-size: 1.1rem;
      }

      a {
        color: var(--color-accent-2);
        text-decoration: none;
        border-bottom: 1px dotted var(--color-accent-2);
        transition: color 0.3s;
      }

      a:hover {
        color: var(--color-highlight);
      }

      ul {
        margin-left: 1.5rem;
        margin-bottom: 1.5rem;
      }

      li {
        margin-bottom: 0.5rem;
        line-height: 1.6;
        color: var(--color-soft); /* Lists distinctive */
      }

      /* Animation Helpers */
      .gsap-header {
        opacity: 0;
        transform: translateY(20px);
      }

      /* Word Highlighting Styles */
      .word {
        opacity: 0.2;
        color: var(--color-accent-1);
        transition: opacity 0.1s, color 0.1s;
      }
      
      .word.highlighted {
        opacity: 1;
        color: var(--color-text);
      }

      .visual-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, transparent, var(--color-bg));
        opacity: 0.3;
      }
    </style>
  </head>
  <body>
    <main class="scrolly-container">
      <!-- Intro Section -->
      <section id="intro">
        <div class="content-wrapper">
          <span class="section-name gsap-header">Introduction</span>
          <h1 class="gsap-header">Garden City: Work, Rest & Tech Culture</h1>
          <blockquote class="gsap-header">
            "From creation to the final heavenly city"
          </blockquote>
          <div class="text-content">
            <p>
              John Mark Comer's <em>Garden City</em> reframes our 9-to-5 as part of
              God's grand story. It helps us find our place in the divine plan, moving
              from the first garden to the final city.
            </p>
            <p>
              In Genesis, humanity is made to "work it and take care of it" as
              an act of service. Even coding or system administration can be
              sacred—our tech work becomes <em>worship</em>
              when we use it to care for God's world.
            </p>
            <p>
              The future isn't just a return to Eden, but a journey forward into
              a "Garden-like world" where we cooperate with God in building a
              civilization for human flourishing.
            </p>
          </div>
        </div>
        <div class="visual-wrapper">
          <img
            src="https://picsum.photos/seed/garden1/800/1000"
            alt="Nature and City"
            class="visual-image"
          />
          <div class="visual-overlay"></div>
        </div>
      </section>

      <!-- Section 1 -->
      <section id="calling">
        <div class="content-wrapper">
          <span class="section-name gsap-header">Part I</span>
          <h2 class="gsap-header">Your Calling: Work as God's Mission</h2>
          <blockquote class="gsap-header">
            "Whatever you do, work heartily, as for the Lord"
          </blockquote>
          <div class="text-content">
            <p>
              Comer emphasizes that <strong>every</strong> job matters. "All work
              is holy" by God's design. We were not made to pull church and career
              apart.
            </p>
            <p>
              As a believer in tech, you have a <strong>dual vocation</strong>:
            </p>
            <ul>
              <li>
                <strong>Professional:</strong> Make your company's systems sing, as
                if recreating Eden.
              </li>
              <li>
                <strong>Disciple:</strong> Let your character raise questions about
                meaning, hope, and joy.
              </li>
            </ul>
            <p>
              There is no sacred-secular divide. Whether engineering software or
              managing data, you are stewarding Creation. Ask yourself: <em
                >Does my project make the world more 'garden-like'?</em
              >
            </p>
          </div>
        </div>
        <div class="visual-wrapper">
          <img
            src="https://picsum.photos/seed/work1/800/1000"
            alt="Work space"
            class="visual-image"
          />
          <div class="visual-overlay"></div>
        </div>
      </section>

      <!-- Section 2 -->
      <section id="identity">
        <div class="content-wrapper">
          <span class="section-name gsap-header">Part II</span>
          <h2 class="gsap-header">Identity: Image Bearers, Not Just Doers</h2>
          <blockquote class="gsap-header">
            "In God's image," not your job
          </blockquote>
          <div class="text-content">
            <p>
              Tech culture often defines us by titles or output ("I'm a
              developer at X").
              <em>Garden City</em> pushes back: your primary identity is in God, not
              your career.
            </p>
            <p>
              Scripture says who we are (God's beloved) gives meaning to what we
              do, not the reverse. This frees us from performance-driven
              anxiety.
            </p>
            <p>
              Like J.S. Bach signing music <em>Soli Deo Gloria</em> ("to the glory
              of God"), our code can carry the same motto. Let <strong
                >who you are in Christ</strong
              > guide how you work, countering the idol of busyness.
            </p>
          </div>
        </div>
        <div class="visual-wrapper">
          <img
            src="https://picsum.photos/seed/identity1/800/1000"
            alt="Reflection"
            class="visual-image"
          />
          <div class="visual-overlay"></div>
        </div>
      </section>

      <!-- Section 3 -->
      <section id="rest">
        <div class="content-wrapper">
          <span class="section-name gsap-header">Part III</span>
          <h2 class="gsap-header">Rest & Resilience: Rediscovering Sabbath</h2>
          <blockquote class="gsap-header">"We are not machines"</blockquote>
          <div class="text-content">
            <p>
              The tech world glorifies hustle. But God worked six days and "on
              the seventh day he rested."
              <em>Garden City</em> stresses that burnout is real. Rest isn't just
              a nap; it's a deliberate pause.
            </p>
            <p>
              Tiffany Shlain coins the <strong>"Tech Sabbath"</strong>—one day a
              week without screens. It's an oasis of peace.
            </p>
            <p>
              By resting, we acknowledge "God is God and we are not." We trust
              Him rather than our own productivity.
            </p>
          </div>
        </div>
        <div class="visual-wrapper">
          <img
            src="https://picsum.photos/seed/relax/800/1000"
            alt="Peaceful nature"
            class="visual-image"
          />
          <div class="visual-overlay"></div>
        </div>
      </section>

      <!-- Section 4 -->
      <section id="kingdom">
        <div class="content-wrapper">
          <span class="section-name gsap-header">Part IV</span>
          <h2 class="gsap-header">Living in the Kingdom</h2>
          <blockquote class="gsap-header">
            "Building a Kingdom on earth"
          </blockquote>
          <div class="text-content">
            <p>
              Every office is a <strong>missional</strong> context. Companies often
              have unspoken agendas (profit, consumerism). We enter with a Kingdom
              worldview.
            </p>
            <p>
              Comer invites us to think big: we are helping build a civilization
              where God's will is done "on earth as it is in heaven."
            </p>
            <p>
              Every ethical decision, helpful tool, or faithful action pushes
              back darkness and spreads the beauty of God's Kingdom.
            </p>
          </div>
        </div>
        <div class="visual-wrapper">
          <img
            src="https://picsum.photos/seed/city/800/1000"
            alt="Urban building"
            class="visual-image"
          />
          <div class="visual-overlay"></div>
        </div>
      </section>

      <!-- Section 5 -->
      <section id="faith">
        <div class="content-wrapper">
          <span class="section-name gsap-header">Part V</span>
          <h2 class="gsap-header">Faith at Work</h2>
          <blockquote class="gsap-header">"Live your faith softly"</blockquote>
          <div class="text-content">
            <p>
              In secular tech firms, overt evangelism is often unwelcome.
              Instead, focus on excellence and kindness. Let your work ethic and
              integrity do the talking.
            </p>
            <p>
              Like Daniel, who served faithfully in a pagan culture without
              compromising his core beliefs, we can refuse unethical practices
              while excelling at our assignments.
            </p>
            <p>
              Whether your workplace is "Faith-Avoiding" or "Faith-Tolerant,"
              serve the Lord Christ through your competence and character.
            </p>
          </div>
        </div>
        <div class="visual-wrapper">
          <img
            src="https://picsum.photos/seed/office/800/1000"
            alt="Modern office"
            class="visual-image"
          />
          <div class="visual-overlay"></div>
        </div>
      </section>

      <!-- Section 6 -->
      <section id="applying">
        <div class="content-wrapper">
          <span class="section-name gsap-header">Part VI</span>
          <h2 class="gsap-header">Applying Garden City</h2>
          <blockquote class="gsap-header">
            "Your tech job is God's job"
          </blockquote>
          <div class="text-content">
            <p>
              <strong>Concrete steps for techies:</strong>
            </p>
            <ul>
              <li>
                <strong>Work Heartily:</strong> Write clean code to honor God.
              </li>
              <li>
                <strong>Envision Impact:</strong> Does this help humans flourish?
              </li>
              <li>
                <strong>Rest Intentionally:</strong> Try a screen-free Sabbath.
              </li>
              <li>
                <strong>Live Out Faith:</strong> Be the person others point to as
                an example of what is best.
              </li>
              <li>
                <strong>Keep Eternity in View:</strong> We are building Heaven's city,
                one task at a time.
              </li>
            </ul>
            <p>
              <em>Garden City</em> allows us to see our work with new eyes. We are
              co-creators in God's world.
            </p>
          </div>
        </div>
        <div class="visual-wrapper">
          <img
            src="https://picsum.photos/seed/code/800/1000"
            alt="Laptop and code"
            class="visual-image"
          />
          <div class="visual-overlay"></div>
        </div>
      </section>
    </main>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const sections = document.querySelectorAll("section");

      sections.forEach((section, index) => {
        // 1. Text Splitting for Word Highlight
        const paragraphs = section.querySelectorAll(".text-content p");
        paragraphs.forEach((p) => {
          // Wrap words in span.word
          // Preserve basic HTML inside like <em> or <strong> is tricky with simple split.
          // But looking at content, it has <em> and <strong>. 
          // Simple textContent split destroys tags.
          // We need a smarter split or just accept text node splitting.
          // For simplicity and safety with existing HTML, let's just animate the paragraphs 
          // if we can't safely split.
          // BUT the user specifically asked for "Word Highlighting".
          // I'll implement a recursive text node splitter to be safe.
          
          function wrapWords(node) {
            if (node.nodeType === 3) { // Text node
               const text = node.nodeValue;
               // Skip empty text nodes
               if(!text.trim()) return;
               
               const words = text.split(" ");
               const frag = document.createDocumentFragment();
               words.forEach((word, i) => {
                   if(word === "") return;
                   const span = document.createElement("span");
                   span.className = "word";
                   span.textContent = word + (i < words.length - 1 ? " " : "");
                   frag.appendChild(span);
               });
               if(frag.childNodes.length > 0) {
                   node.parentNode.replaceChild(frag, node);
               }
            } else if (node.nodeType === 1) { // Element node
                Array.from(node.childNodes).forEach(wrapWords);
            }
          }
          
          wrapWords(p);
        });

        const words = section.querySelectorAll(".word");
        const headers = section.querySelectorAll(".gsap-header");
        const image = section.querySelector(".visual-image");
        const lists = section.querySelectorAll("ul");

        // 2. Create Timeline
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            pin: true, 
            start: "top top",
            end: "+=200%", // 200% screen height scroll distance
            scrub: 0.5,
          }
        });

        // 3. Animation Sequence
        
        // A. Header reveal (happens quickly at start of pin)
        if(headers.length > 0) {
            tl.to(headers, {
                opacity: 1,
                y: 0,
                duration: 0.5, 
                stagger: 0.1,
                ease: "power2.out"
            });
        }

        // B. Word Highlighting (takes up most of the scroll)
        if(words.length > 0) {
             tl.to(words, {
                 opacity: 1,
                 color: "var(--color-text)",
                 stagger: {
                     each: 0.05,
                     from: "start"
                 },
                 ease: "none" // Linear highlight matching scroll
             }, "<0.2"); // Overlap slightly with header
        }
        
        // C. Lists Fade In (if any)
        if(lists.length > 0) {
            tl.fromTo(lists, 
                { opacity: 0 },
                { opacity: 1, duration: 0.5 },
                ">" // After words
            );
        }

        // D. Image Animation (Parallax/Scale during the whole pin)
        if(image) {
            gsap.fromTo(image, 
                { scale: 1.1, opacity: 0.6 },
                { 
                    scale: 1, 
                    opacity: 1, 
                    scrollTrigger: {
                        trigger: section,
                        start: "top top",
                        end: "+=200%", // Match pin duration
                        scrub: true
                    }
                }
            );
        }
      });
    </script>
  </body>
</html>